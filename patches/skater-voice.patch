diff --git a/platform/pc/include/pc/voice.h b/platform/pc/include/pc/voice.h
new file mode 100644
index 0000000..8bfeb09
--- /dev/null
+++ b/platform/pc/include/pc/voice.h
@@ -0,0 +1,74 @@
+/* A mod skater's voice lines (pc_voice.cpp; the game's C interface is pc_voice.h).
+ *
+ * [Voice] in a mod's Skaters/<name>.ini names WAV files (16-bit PCM; mono at 44.1 kHz plays as
+ * is, anything else is mixed down and resampled) in the mod's Data folder. Where a list is given
+ * one is picked at random:
+ *   Start             when a run starts (the skater's first physics frame)
+ *   Trick             when a trick scores, at TrickChance percent (default 30), and only when
+ *                     Gap seconds (default 6) have passed since the last line ended (game
+ *                     frames: a line "plays" for its length on the frame clock)
+ *   Bail              when the skater bails, cutting off anything playing
+ *   AfterBail         after the Bail clip, at AfterBailChance percent (default 50)
+ *   Volume            percent of the sound effects' level (default 100)
+ * One line plays at a time, on top of the sound effects (pc/sound.h's clip). */
+#pragma once
+
+#include <stdint.h>
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "pc/game_data.h"
+
+namespace pc {
+
+class Voice {
+public:
+    enum Event { kStart, kTrick, kBail, kAfterBail, kEvents };
+
+    /* One skater's [Voice]. */
+    struct Set {
+        std::vector<std::string> clips[kEvents];
+        int chance[kEvents] = {100, 30, 100, 50};
+        int gap = 6 * 60;         /* frames */
+        int level = 0x4000;       /* pc::Sound::kFull = 100% */
+        /* One entry; false if the key isn't one of [Voice]'s. */
+        bool Read(const char *key, const char *value);
+        bool Any() const;
+    };
+
+    void Assign(int skater, const Set &set);
+
+    /* pc_voice.h's events */
+    void Run(int skater);
+    void Frame(int skater);
+    void Trick(int skater);
+    void Bail(int skater);
+
+private:
+    struct Clip {
+        std::string name;
+        std::vector<int16_t> pcm;   /* mono at pc::Sound::kRate; empty if it can't be played */
+        bool tried = false;
+    };
+
+    bool Has(int skater, Event e) const;
+    uint32_t Random();
+    bool Roll(int percent);
+    /* A random clip of the skater's for the event, loaded on first use; null if it can't be. */
+    const Clip *Pick(int skater, Event e);
+    void Play(int skater, Event e);
+
+    Set m_sets[GAME_MAX_SKATERS];
+    std::map<std::string, Clip> m_clips;
+    bool m_startDue[GAME_MAX_SKATERS] = {};
+    int m_afterBail = -1;         /* the skater whose AfterBail is due, at m_afterBailAt */
+    uint32_t m_afterBailAt = 0;
+    uint32_t m_lineEnds = 0;      /* PC_FrameCount when the line playing ends */
+    uint32_t m_rng = 0;
+};
+
+extern Voice g_voice;
+
+} // namespace pc
diff --git a/platform/pc/include/pc_voice.h b/platform/pc/include/pc_voice.h
new file mode 100644
