+/* A mod skater's voice lines, at the game's moments (pc_voice.cpp; the class is pc::Voice,
+ * pc/voice.h). The game says what happened to which skater (CBruce::mSkaterIndex); a skater
+ * without a [Voice] in its manifest says nothing. */
+#ifndef PC_VOICE_H
+#define PC_VOICE_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    PC_VOICE_RUN,   /* the skater was made for a run (CreateSkatersAndCameras) */
+    PC_VOICE_FRAME, /* its physics frame (CBruce::DoPhysics): the run's opening line goes here */
+    PC_VOICE_TRICK, /* a trick scored (CBruce::Trick_Trick) */
+    PC_VOICE_BAIL   /* it bailed (CBruce::Bail) */
+};
+
+void PC_SkaterVoice(int skater, int event);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/platform/pc/src/pc_voice.cpp b/platform/pc/src/pc_voice.cpp
new file mode 100644
index 0000000..3d43fcb
--- /dev/null
+++ b/platform/pc/src/pc_voice.cpp
@@ -0,0 +1,239 @@
+/* A mod skater's voice lines (pc/voice.h, pc_voice.h). */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "pc/assets.h"
+#include "pc/platform.h"
+#include "pc/sound.h"
+#include "pc/voice.h"
+#include "pc_frame.h"
+#include "pc_runtime.h"
+#include "pc_voice.h"
+
+namespace pc {
+
+Voice g_voice;
+
+namespace {
+
+const char *const kKeys[Voice::kEvents] = {"Start", "Trick", "Bail", "AfterBail"};
+constexpr int kAfterBailPause = 12; /* frames between the Bail clip and the AfterBail one */
+
+uint32_t Le32(const uint8_t *p) { return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24; }
+int16_t Le16(const uint8_t *p) { return (int16_t)(p[0] | p[1] << 8); }
+
+bool Trace() {
+    static int trace = -1;
+    if (trace < 0)
+        trace = getenv("THPS_TRACE_SOUND") && atoi(getenv("THPS_TRACE_SOUND"));
+    return trace;
+}
+
+/* A RIFF WAV of 16-bit PCM, as mono at Sound::kRate (mixed down, resampled linearly). */
+bool LoadWav(const char *path, std::vector<int16_t> &out) {
+    FILE *f = fopen(path, "rb");
+    if (!f)
+        return false;
+    std::vector<uint8_t> d;
+    fseek(f, 0, SEEK_END);
+    long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    d.resize(n > 0 ? (size_t)n : 0);
+    bool ok = n > 12 && fread(d.data(), 1, d.size(), f) == d.size();
+    fclose(f);
+    if (!ok || memcmp(d.data(), "RIFF", 4) || memcmp(d.data() + 8, "WAVE", 4))
+        return false;
+    int format = 0, channels = 0, bits = 0;
+    uint32_t rate = 0, size = 0;
+    const uint8_t *data = nullptr;
+    for (size_t p = 12; p + 8 <= d.size();) {
+        uint32_t len = Le32(&d[p + 4]);
+        if (len > d.size() - p - 8)
+            len = (uint32_t)(d.size() - p - 8);
+        if (!memcmp(&d[p], "fmt ", 4) && len >= 16) {
+            format = (uint16_t)Le16(&d[p + 8]);
+            channels = (uint16_t)Le16(&d[p + 10]);
+            rate = Le32(&d[p + 12]);
+            bits = (uint16_t)Le16(&d[p + 22]);
+        } else if (!memcmp(&d[p], "data", 4)) {
+            data = &d[p + 8];
+            size = len;
+        }
+        p += 8 + len + (len & 1);
+    }
+    if (format != 1 || bits != 16 || channels < 1 || !rate || !data)
+        return false;
+    uint32_t frames = size / (2 * channels);
+    std::vector<int> mono(frames);
+    for (uint32_t i = 0; i < frames; i++) {
+        int s = 0;
+        for (int c = 0; c < channels; c++)
+            s += Le16(data + 2 * ((size_t)i * channels + c));
+        mono[i] = s / channels;
+    }
+    out.resize((size_t)((uint64_t)frames * Sound::kRate / rate));
+    for (size_t i = 0; i < out.size(); i++) {
+        uint64_t at = (uint64_t)i * rate;
+        uint32_t j = (uint32_t)(at / Sound::kRate), frac = (uint32_t)(at % Sound::kRate);
+        int a = mono[j], b = j + 1 < frames ? mono[j + 1] : a;
+        out[i] = (int16_t)(a + (int64_t)(b - a) * frac / Sound::kRate);
+    }
+    return true;
+}
+
+} // namespace
+
+bool Voice::Set::Read(const char *key, const char *value) {
+    char chance[32];
+    for (int e = 0; e < kEvents; e++) {
+        if (!_stricmp(key, kKeys[e])) {
+            clips[e].clear();
+            for (const char *p = value; *p;) {
+                size_t len = strcspn(p, ",");
+                std::string name(p, len);
+                name.erase(0, name.find_first_not_of(" \t"));
+                name.erase(name.find_last_not_of(" \t") + 1);
+                if (!name.empty())
+                    clips[e].push_back(name);
+                p += len + (p[len] == ',');
+            }
+            return true;
+        }
+        snprintf(chance, sizeof chance, "%sChance", kKeys[e]);
+        if (!_stricmp(key, chance)) {
+            int v = atoi(value);
+            this->chance[e] = v < 0 ? 0 : v > 100 ? 100 : v;
+            return true;
+        }
+    }
+    if (!_stricmp(key, "Gap")) {
+        gap = (int)(atof(value) * 60);
+        return true;
+    }
+    if (!_stricmp(key, "Volume")) {
+        level = atoi(value) * Sound::kFull / 100;
+        return true;
+    }
+    return false;
+}
+
+bool Voice::Set::Any() const {
+    for (const auto &c : clips)
+        if (!c.empty())
+            return true;
+    return false;
+}
+
+void Voice::Assign(int skater, const Set &set) {
+    if (skater >= 0 && skater < GAME_MAX_SKATERS)
+        m_sets[skater] = set;
+}
+
+bool Voice::Has(int skater, Event e) const {
+    return skater >= 0 && skater < GAME_MAX_SKATERS && !m_sets[skater].clips[e].empty();
+}
+
+/* xorshift32, apart from the game's random numbers so a voice never changes what happens;
+ * THPS_DETERMINISTIC runs pick the same lines every time */
+uint32_t Voice::Random() {
+    if (!m_rng)
+        m_rng = getenv("THPS_DETERMINISTIC") ? 0x9e3779b9u : ((uint32_t)time(nullptr) * 2654435761u) | 1;
+    m_rng ^= m_rng << 13;
+    m_rng ^= m_rng >> 17;
+    m_rng ^= m_rng << 5;
+    return m_rng;
+}
+
+bool Voice::Roll(int percent) { return (int)(Random() % 100) < percent; }
+
+const Voice::Clip *Voice::Pick(int skater, Event e) {
+    const auto &list = m_sets[skater].clips[e];
+    const std::string &name = list[Random() % list.size()];
+    Clip &c = m_clips[name];
+    if (!c.tried) {
+        char path[1024];
+        c.tried = true;
+        c.name = name;
+        if (!g_assets.Find(name.c_str(), path, sizeof path) || !LoadWav(path, c.pcm)) {
+            PC_Log("voice: cannot play %s (it needs to be a 16-bit PCM WAV in Data/)", name.c_str());
+            c.pcm.clear();
+        }
+    }
+    return c.pcm.empty() ? nullptr : &c;
+}
+
+void Voice::Play(int skater, Event e) {
+    const Clip *c = Pick(skater, e);
+    if (!c)
+        return;
+    g_sound.ClipPlay(c->pcm.data(), (uint32_t)c->pcm.size(), m_sets[skater].level);
+    m_lineEnds = PC_FrameCount() + (uint32_t)((uint64_t)c->pcm.size() * 60 / Sound::kRate) + 1;
+    if (Trace())
+        PC_Log("voice: %s: %s", kKeys[e], c->name.c_str());
+}
+
+void Voice::Run(int skater) {
+    if (skater < 0 || skater >= GAME_MAX_SKATERS || !m_sets[skater].Any())
+        return;
+    g_sound.ClipPlay(nullptr, 0, 0);
+    m_startDue[skater] = Has(skater, kStart);
+    m_afterBail = -1;
+    m_lineEnds = PC_FrameCount();
+}
+
+void Voice::Frame(int skater) {
+    if (skater < 0 || skater >= GAME_MAX_SKATERS)
+        return;
+    if (m_startDue[skater]) {
+        m_startDue[skater] = false;
+        Play(skater, kStart);
+    }
+    if (m_afterBail == skater && (int32_t)(PC_FrameCount() - m_afterBailAt) >= 0) {
+        m_afterBail = -1;
+        Play(skater, kAfterBail);
+    }
+}
+
+/* "Playing" is on the frame clock (m_lineEnds), as the game's moments are */
+void Voice::Trick(int skater) {
+    if (!Has(skater, kTrick) || m_afterBail >= 0)
+        return;
+    const Set &s = m_sets[skater];
+    if ((int32_t)(PC_FrameCount() - (m_lineEnds + (uint32_t)s.gap)) >= 0 && Roll(s.chance[kTrick]))
+        Play(skater, kTrick);
+}
+
+void Voice::Bail(int skater) {
+    if (!Has(skater, kBail) && !Has(skater, kAfterBail))
+        return;
+    const Set &s = m_sets[skater];
+    uint32_t now = PC_FrameCount();
+    m_afterBail = -1;
+    if (Has(skater, kBail) && Roll(s.chance[kBail]))
+        Play(skater, kBail);
+    if (Has(skater, kAfterBail) && Roll(s.chance[kAfterBail])) {
+        m_afterBail = skater;
+        m_afterBailAt = ((int32_t)(m_lineEnds - now) > 0 ? m_lineEnds : now) + kAfterBailPause;
+    }
+}
+
+} // namespace pc
+
+void PC_SkaterVoice(int skater, int event) {
+    switch (event) {
+    case PC_VOICE_RUN:
+        pc::g_voice.Run(skater);
+        break;
+    case PC_VOICE_FRAME:
+        pc::g_voice.Frame(skater);
+        break;
+    case PC_VOICE_TRICK:
+        pc::g_voice.Trick(skater);
+        break;
+    case PC_VOICE_BAIL:
+        pc::g_voice.Bail(skater);
+        break;
+    }
+}
